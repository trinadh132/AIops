# Copy to .env and fill in. .env is gitignored; this file is not.

# OpenRouter key — used for embeddings, diagnosis LLM, and web search.
OPENROUTER_API=sk-or-v1-replace-me

# Matches the pgvector service in docker-compose.yml.
DATABASE_URL=postgresql://ops_agent:ops_agent_dev@localhost:5432/ops_agent_rag

# Optional overrides (defaults live in llm.py / searchllm.py).
# DIAGNOSIS_MODEL=z-ai/glm-5.2:free
# DIAGNOSIS_FALLBACK_MODELS=minimax/minimax-m3:free,nvidia/nemotron-3-ultra-550b-a55b:free
# SEARCH_MODEL=minimax/minimax-m3:free

# MCP server (mcp_server.py). Required for --http; stdio doesn't use it.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=replace-me
# inject_failure / request_approval tools. Off unless set to true.
# MCP_ENABLE_WRITE_TOOLS=false
