<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
      JSON structured logs. Every simulated failure logs failure_mode and
      event_type via MDC so downstream (CloudWatch, or later the agent's
      retrieval/diagnose step) can filter and correlate on them directly.
    -->
    <appender name="STDOUT_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>failure_mode</includeMdcKeyName>
            <includeMdcKeyName>event_type</includeMdcKeyName>
            <includeMdcKeyName>request_id</includeMdcKeyName>
            <customFields>{"service":"self-healing-ops-mock-service"}</customFields>
        </encoder>
    </appender>

    <appender name="FILE_JSON" class="ch.qos.logback.core.FileAppender">
        <file>logs/mock-service.log</file>
        <append>true</append>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>failure_mode</includeMdcKeyName>
            <includeMdcKeyName>event_type</includeMdcKeyName>
            <includeMdcKeyName>request_id</includeMdcKeyName>
            <customFields>{"service":"self-healing-ops-mock-service"}</customFields>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT_JSON" />
    </root>

    <!--
      The file copy only exists for capture-logs.ps1 when running locally via
      mvn/java. Containers set SPRING_PROFILES_ACTIVE=container and log to
      stdout only: the Docker/awslogs driver collects it, and an unrotated
      file would otherwise grow until the container's disk fills.
    -->
    <springProfile name="!container">
        <root level="INFO">
            <appender-ref ref="FILE_JSON" />
        </root>
    </springProfile>

</configuration>